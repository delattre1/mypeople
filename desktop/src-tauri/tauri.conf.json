{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPlow",
  "version": "5.7.10",
  "identifier": "co.plow.mypeople",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyPlow",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "resources": ["runtime"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
